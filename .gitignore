.env*
!.env.example
*.dat
wallets/
*.key
*.pem
__pycache__/
.venv/
node_modules/
build/
.pytest_cache/

# Python build output (NOT web/dist, which is the hand-authored app and IS committed)
/dist/
*.egg-info/

# demo wallet files: only the manifest is committed (vaults are regenerated)
data/demo/*
!data/demo/manifest.json
!scripts/wallets/

# finished-job receipts are written at runtime
data/jobs/
